rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserData(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, create, update, delete: if ownsUserData(userId);
    }

    match /users/{userId}/{collectionName}/{documentId} {
      allow read, write: if ownsUserData(userId)
        && collectionName in [
          "inflows",
          "expenses",
          "recurringExpenses",
          "notifications",
          "devices",
          "settings"
        ];
    }
  }
}
